module: "enterprise_operations"
db: "Sqlite"
security: {
    access: { default_read: Authenticated }
    requests: { json_max_bytes: 65536 }
    auth: {
        issuer: "https://identity.example.test"
        audience: "enterprise-operations"
        access_token_ttl_seconds: 900
        claims: { tenant_id: { type: "I64" } }
    }
}
resources: [
    {
        name: "Project"
        roles: { read: "reader", create: "editor", update: "editor", delete: "manager" }
        policies: {
            admin_bypass: false
            read: { field: "tenant_id", equals: "claim.tenant_id" }
            create: [
                { field: "tenant_id", value: "claim.tenant_id" }
                { field: "owner_user_id", value: "user.id" }
            ]
            update: [
                { field: "tenant_id", equals: "claim.tenant_id" }
                { field: "owner_user_id", equals: "user.id" }
            ]
            delete: { field: "tenant_id", equals: "claim.tenant_id" }
        }
        indexes: [{ fields: ["tenant_id", "id"] }]
        fields: [
            { name: "id", type: "I64" }
            { name: "tenant_id", type: "I64" }
            { name: "owner_user_id", type: "I64" }
            { name: "name", type: "String" }
            { name: "cost_center", type: "String" }
        ]
    }
    {
        name: "ChangeRequest"
        roles: { read: "reader", create: "editor", update: "editor", delete: "manager" }
        policies: {
            admin_bypass: false
            read: { field: "tenant_id", equals: "claim.tenant_id" }
            create: [
                { field: "tenant_id", value: "claim.tenant_id" }
                { field: "owner_user_id", value: "user.id" }
            ]
            update: [
                { field: "tenant_id", equals: "claim.tenant_id" }
                { field: "owner_user_id", equals: "user.id" }
            ]
            delete: { field: "tenant_id", equals: "claim.tenant_id" }
        }
        indexes: [{ fields: ["tenant_id", "id"] }, { fields: ["project_id"] }]
        fields: [
            { name: "id", type: "I64" }
            { name: "tenant_id", type: "I64" }
            { name: "owner_user_id", type: "I64" }
            { name: "project_id", type: "I64", relation: { references: "project.id", on_delete: Restrict } }
            { name: "summary", type: "String" }
            { name: "justification", type: "String" }
        ]
    }
    {
        name: "Asset"
        roles: { read: "reader", create: "editor", update: "editor", delete: "manager" }
        policies: {
            admin_bypass: false
            read: { field: "tenant_id", equals: "claim.tenant_id" }
            create: [
                { field: "tenant_id", value: "claim.tenant_id" }
                { field: "owner_user_id", value: "user.id" }
            ]
            update: [
                { field: "tenant_id", equals: "claim.tenant_id" }
                { field: "owner_user_id", equals: "user.id" }
            ]
            delete: { field: "tenant_id", equals: "claim.tenant_id" }
        }
        indexes: [{ fields: ["tenant_id", "id"] }, { fields: ["project_id"] }]
        fields: [
            { name: "id", type: "I64" }
            { name: "tenant_id", type: "I64" }
            { name: "owner_user_id", type: "I64" }
            { name: "project_id", type: "I64", relation: { references: "project.id", on_delete: Restrict } }
            { name: "name", type: "String" }
            { name: "critical", type: "Bool" }
        ]
    }
    {
        name: "PrivateNote"
        roles: { read: "reader", create: "editor", update: "editor", delete: "manager" }
        policies: {
            admin_bypass: false
            read: [
                { field: "tenant_id", equals: "claim.tenant_id" }
                { field: "owner_user_id", equals: "user.id" }
            ]
            create: [
                { field: "tenant_id", value: "claim.tenant_id" }
                { field: "owner_user_id", value: "user.id" }
            ]
            update: [
                { field: "tenant_id", equals: "claim.tenant_id" }
                { field: "owner_user_id", equals: "user.id" }
            ]
            delete: [
                { field: "tenant_id", equals: "claim.tenant_id" }
                { field: "owner_user_id", equals: "user.id" }
            ]
        }
        indexes: [{ fields: ["tenant_id", "owner_user_id", "id"] }]
        fields: [
            { name: "id", type: "I64" }
            { name: "tenant_id", type: "I64" }
            { name: "owner_user_id", type: "I64" }
            { name: "subject", type: "String" }
            { name: "body", type: "String" }
        ]
    }
]
