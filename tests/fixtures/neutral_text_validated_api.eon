security: {
    requests: { json_max_bytes: 128 }
}
resources: [
    {
        name: "Note"
        roles: {
            read: "user"
            create: "user"
            update: "user"
            delete: "user"
        }
        fields: [
            { name: "id", type: I64, id: true }
            { name: "title", type: String, garde: { length: { min: 3, max: 5, mode: Chars } } }
        ]
    }
]
